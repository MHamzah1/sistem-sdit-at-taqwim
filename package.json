        "qrcode": "^1.5.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "ws": "^8.21.3",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.18",
        "@types/node": "^22.20.2",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/ws": "^8.18.1",
        "@vercel/node": "^13.0.0",
        "@vitejs/plugin-react": "^6.0.1",
        "drizzle-kit": "^0.31.7",
