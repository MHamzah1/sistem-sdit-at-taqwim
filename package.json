{
    "name": "sistem-spp-kelayakan-ujian",
    "private": true,
    "packageManager": "npm@10",
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite",
        "dev:api": "tsx watch server/dev.ts",
        "build": "vite build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
